# ==============================================================================
# SECRETS TEMPLATE (DO NOT COMMIT ACTUAL SECRETS TO GIT)
# ==============================================================================
# In production GitOps, secrets are NEVER committed to version control in plaintext.
#
# Option A (Manual Cluster Bootstrap):
# Run directly on your cluster:
#   kubectl create secret generic microservices-secrets \
#     --namespace microservices \
#     --from-literal=db-password="$(openssl rand -base64 24)" \
#     --dry-run=client -o yaml | kubectl apply -f -
#
# Option B (External Secrets Operator - ESO):
# If syncing from AWS ParameterStore, HashiCorp Vault, or 1Password,
# use an ExternalSecret manifest pointing to your SecretStore.
# ==============================================================================

apiVersion: v1
kind: Secret
metadata:
  name: microservices-secrets
  namespace: microservices
type: Opaque
stringData:
  db-password: "REPLACE_WITH_STRONG_RANDOM_PASSWORD"
